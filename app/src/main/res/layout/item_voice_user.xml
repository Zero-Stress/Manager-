<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@drawable/bg_fancy_card"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="4dp"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="Avatar"
        android:background="@drawable/bg_fancy_button_gold"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvVoiceUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Username"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvUserTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/gold"
                android:textSize="10sp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvVoiceUserStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/green"
            android:textSize="11sp"
            android:layout_marginTop="2dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/ivMicStatus"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="Mic"
                android:tint="@color/green"/>

            <ImageView
                android:id="@+id/ivSpeakingIndicator"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="Speaking"
                android:tint="@color/green"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>

            <ImageView
                android:id="@+id/ivHandRaised"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_launcher_foreground"
                android:contentDescription="Hand"
                android:tint="@color/gold"
                android:layout_marginStart="8dp"
                android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/ivUserStatus"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/ic_launcher_foreground"
        android:contentDescription="Online"
        android:tint="@color/green"/>

</LinearLayout>
