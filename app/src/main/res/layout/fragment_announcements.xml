<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090d16"
    android:padding="16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📢 Announcements"
        android:textColor="#38bdf8"
        android:textSize="18sp"
        android:textStyle="bold"
        android:padding="12" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12"
        android:hint="Type announcement message..."
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/announcement_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:gravity="top"
            android:textColor="#f1f5f9"
            android:backgroundTint="#38bdf8" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/post_announcement_btn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="PUBLISH TO ALL PLAYERS"
        android:textColor="#090d16"
        android:textStyle="bold"
        android:backgroundTint="#38bdf8"
        android:layout_marginBottom="20" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/announcement_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
