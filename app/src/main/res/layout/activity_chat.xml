<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090d16">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="#131c31">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💬 Team Chat"
            android:textColor="#38bdf8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Clear Chat (admin only) -->
        <TextView
            android:id="@+id/btnClearChat"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="🗑️ Clear"
            android:textColor="#ff6b6b"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:background="@drawable/bg_input"
            android:layout_marginEnd="8dp"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Input Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#131c31">

        <!-- @ Mention Button -->
        <TextView
            android:id="@+id/btnMention"
            android:layout_width="42dp"
            android:layout_height="48dp"
            android:text="@"
            android:textColor="#38bdf8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/bg_input"
            android:layout_marginEnd="6dp" />

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input"
            android:hint="Type a message..."
            android:textColor="#f1f5f9"
            android:textColorHint="#475569"
            android:paddingHorizontal="14dp"
            android:textSize="14sp"
            android:singleLine="true"
            android:imeOptions="actionSend"
            android:inputType="text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="52dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:text="➤"
            android:textColor="#090d16"
            android:textSize="18sp"
            app:backgroundTint="#38bdf8"
            app:cornerRadius="24dp" />
    </LinearLayout>

</LinearLayout>
