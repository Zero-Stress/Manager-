<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FF0D1117">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:background="#FF161B22"
        android:gravity="center_vertical"
        android:elevation="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_back"
            android:padding="8dp"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎙️ Voice Arena"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvVoiceStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔴 Not connected"
                    android:textColor="#FF8B949E"
                    android:textSize="12sp"/>

                <TextView
                    android:id="@+id/tvTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="#FF58A6FF"
                    android:textSize="11sp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvUserStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🟢 Online"
            android:textColor="#FF3FB950"
            android:textSize="11sp"
            android:background="@drawable/bg_status_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"/>
    </LinearLayout>

    <!-- Scrollable Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Admin Panel -->
            <LinearLayout
                android:id="@+id/tvAdminPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FF1C2333"
                android:padding="12dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👑 ADMIN CONTROLS"
                    android:textColor="#FFFFD700"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnManagePermissions"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="👥 Manage Voice Permissions"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp"
                    android:layout_marginTop="8dp"
                    app:backgroundTint="#FFFFD700"
                    app:cornerRadius="8dp"/>
            </LinearLayout>

            <!-- Channel Name Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FF238636"
                android:padding="12dp"
                android:layout_marginHorizontal="12dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:id="@+id/tvChannelName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Channel"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Connected Users List -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 CONNECTED USERS"
                    android:textColor="#FF8B949E"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1"
                    android:layout_marginBottom="8dp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvUsers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"/>
            </LinearLayout>

            <!-- Voice Control Buttons - Scrollable -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoinLeave"
                        android:layout_width="140dp"
                        android:layout_height="56dp"
                        android:text="🎙️ Join Voice"
                        android:textColor="#FFFFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="#FF238636"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMute"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="🔇"
                        android:textSize="20sp"
                        android:visibility="gone"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="#FF484F58"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDeafen"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="🔕"
                        android:textSize="20sp"
                        android:visibility="gone"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="#FF484F58"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScreenShare"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="🖥️"
                        android:textSize="20sp"
                        android:visibility="gone"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="#FF484F58"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPushToTalk"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="🎤"
                        android:textSize="20sp"
                        android:visibility="gone"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="#FF484F58"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnHandRaise"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="✋"
                        android:textSize="20sp"
                        android:visibility="gone"
                        android:layout_marginEnd="6dp"
                        app:backgroundTint="#FF484F58"
                        app:cornerRadius="12dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMoreOptions"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="⋯"
                        android:textSize="20sp"
                        android:visibility="gone"
                        app:backgroundTint="#FF484F58"
                        app:cornerRadius="12dp"/>
                </LinearLayout>
            </HorizontalScrollView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Control Panel (Fixed) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FF161B22"
        android:padding="12dp"
        android:elevation="8dp">

        <!-- Chat Input -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/etChatMessage"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chat_input"
                android:hint="Type a message..."
                android:textColor="#FFFFFFFF"
                android:textColorHint="#FF484F58"
                android:textSize="14sp"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:imeOptions="actionSend"
                android:inputType="text"/>

            <ImageButton
                android:id="@+id/btnSendChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_button_accent"
                android:src="@drawable/ic_send"
                android:padding="10dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Send"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Chat Panel (Expandable, overlays bottom) -->
    <LinearLayout
        android:id="@+id/chatContainer"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:background="#FF0D1117"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="# Voice Chat"
            android:textColor="#FF8B949E"
            android:textSize="11sp"
            android:padding="4dp"
            android:layout_marginBottom="4dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvChat"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- Progress -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="#FF58A6FF"/>

</LinearLayout>