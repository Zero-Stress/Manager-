<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090d16">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💬 Team Chat"
        android:textColor="#38bdf8"
        android:textSize="20sp"
        android:textStyle="bold"
        android:padding="16dp" />

    <ScrollView
        android:id="@+id/chat_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/chat_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />
    </ScrollView>

    <!-- Mention suggestions (hidden by default) -->
    <LinearLayout
        android:id="@+id/mention_suggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#131c31"
        android:padding="4dp"
        android:visibility="gone" />

    <!-- Admin clear chat button (hidden by default) -->
    <TextView
        android:id="@+id/clear_chat_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🗑️ Clear All Chat"
        android:textColor="#ef4444"
        android:textSize="13sp"
        android:textStyle="bold"
        android:padding="10dp"
        android:background="#1a0a0a"
        android:gravity="center"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="#131c31">

        <EditText
            android:id="@+id/message_input"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:hint="Type @ to mention a player..."
            android:textColor="#f1f5f9"
            android:textColorHint="#64748b"
            android:background="#1e3a5f"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/send_btn"
            android:layout_width="60dp"
            android:layout_height="48dp"
            android:text="➤"
            android:backgroundTint="#38bdf8"
            android:textColor="#090d16"
            android:textSize="18sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>
</LinearLayout>
