<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg_main"
    android:padding="32dp">

    <!-- Logo Container with Glow -->
    <LinearLayout
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/bg_gaming_card_glow"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/tvLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡"
            android:textSize="72sp"
            android:alpha="0" />
    </LinearLayout>

    <!-- App Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ZERO STRESS"
        android:textColor="@color/primary"
        android:textSize="32sp"
        android:textStyle="bold"
        android:letterSpacing="0.2"
        android:alpha="0"
        android:layout_marginBottom="8dp" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERFORMANCE &amp; LEADERBOARD"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:letterSpacing="0.3"
        android:alpha="0"
        android:layout_marginBottom="48dp" />

    <!-- Loading Container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:alpha="0">

        <!-- Animated Loading Bar -->
        <FrameLayout
            android:layout_width="200dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_gaming_stat_card"
            android:layout_marginBottom="16dp">

            <View
                android:id="@+id/loadingBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gradient_cyan" />
        </FrameLayout>

        <!-- Loading Status -->
        <TextView
            android:id="@+id/tvLoadingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Initializing..."
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Version -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v3.0"
        android:textColor="@color/text_muted"
        android:textSize="10sp"
        android:layout_marginTop="48dp"
        android:alpha="0.5" />

</LinearLayout>
