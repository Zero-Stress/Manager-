<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090d16">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#0f1729"
        android:gravity="center_vertical"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/back_btn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="&#x2190;"
            android:textColor="#38bdf8"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_marginRight="8dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="App Customizer"
                android:textColor="#f1f5f9"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin Only"
                android:textColor="#94a3b8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/save_btn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Save"
            android:textColor="#ffffff"
            android:textAllCaps="false"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PRESET THEMES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Quick Themes"
                android:textColor="#38bdf8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/preset_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="16dp" />

            <!-- APP SETTINGS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App Settings"
                android:textColor="#38bdf8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="App Name"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/input_app_name"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textColor="#f1f5f9"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#1e3a5f"
                android:hint="App Name"
                android:textColorHint="#64748b"
                android:singleLine="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome Message"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:paddingBottom="4dp" />

            <EditText
                android:id="@+id/input_welcome_msg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:textColor="#f1f5f9"
                android:textSize="14sp"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:background="#1e3a5f"
                android:hint="Welcome message"
                android:textColorHint="#64748b"
                android:singleLine="true"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Font Style"
                android:textColor="#94a3b8"
                android:textSize="12sp"
                android:paddingBottom="4dp" />

            <Spinner
                android:id="@+id/spinner_font"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginBottom="16dp" />

            <!-- COLORS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Colors"
                android:textColor="#38bdf8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/color_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="16dp" />

            <!-- UI SIZE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="UI and Button Size"
                android:textColor="#38bdf8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <!-- Button Height -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Button Height" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/btn_height_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="40dp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_btn_height" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="60" android:progress="20" />
            </LinearLayout>

            <!-- Button Corner Radius -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Button Corners" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/btn_radius_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="12dp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_btn_radius" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="30" android:progress="12" />
            </LinearLayout>

            <!-- Button Text Size -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Button Text Size" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/btn_text_size_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="14sp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_btn_text_size" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="10" android:progress="4" />
            </LinearLayout>

            <!-- Icon Size -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Icon Size" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/icon_size_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="24dp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_icon_size" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="28" android:progress="12" />
            </LinearLayout>

            <!-- Header Text Size -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Header Text Size" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/header_text_size_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="20sp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_header_text_size" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="14" android:progress="6" />
            </LinearLayout>

            <!-- Body Text Size -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Body Text Size" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/body_text_size_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="14sp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_body_text_size" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="10" android:progress="4" />
            </LinearLayout>

            <!-- Input Height -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Input Field Height" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/input_height_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="44dp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_input_height" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="40" android:progress="12" />
            </LinearLayout>

            <!-- Nav Bar Height -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Nav Bar Height" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/navbar_height_val" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="56dp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_navbar_height" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="40" android:progress="16" />
            </LinearLayout>

            <!-- LAYOUT -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Layout"
                android:textColor="#38bdf8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Card Corner Radius" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/radius_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="16dp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_radius" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="32" android:progress="16" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:text="Card Padding" android:textColor="#f1f5f9" android:textSize="14sp" />
                <TextView android:id="@+id/padding_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="16dp" android:textColor="#38bdf8" android:textSize="14sp" android:layout_marginRight="8dp" />
                <SeekBar android:id="@+id/seek_padding" android:layout_width="120dp" android:layout_height="wrap_content"
                    android:max="32" android:progress="16" />
            </LinearLayout>

            <SwitchCompat
                android:id="@+id/switch_rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rounded Cards"
                android:textColor="#f1f5f9"
                android:textSize="14sp"
                android:checked="true"
                android:layout_marginBottom="8dp" />

            <SwitchCompat
                android:id="@+id/switch_gradient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gradient Headers"
                android:textColor="#f1f5f9"
                android:textSize="14sp"
                android:checked="true"
                android:layout_marginBottom="16dp" />

            <!-- FEATURES -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Features"
                android:textColor="#38bdf8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <SwitchCompat android:id="@+id/switch_online_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Online Status" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_achievements"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Achievements" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_rewards"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Reward Points" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_analytics"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Analytics Tab" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_squads"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Squads" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_tournaments"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Tournaments" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_schedule"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Schedule" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_chat"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Chat" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_voice_chat"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Voice Chat" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="4dp" />

            <SwitchCompat android:id="@+id/switch_attendance"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Show Attendance" android:textColor="#f1f5f9"
                android:checked="true" android:layout_marginBottom="16dp" />

            <!-- LIVE PREVIEW -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Live Preview"
                android:textColor="#38bdf8"
                android:textSize="16sp"
                android:textStyle="bold"
                android:paddingBottom="8dp" />

            <LinearLayout
                android:id="@+id/preview_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#0f1729" />

            <View
                android:layout_width="match_parent"
                android:layout_height="32dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
