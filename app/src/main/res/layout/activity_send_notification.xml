<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_main"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📢 SEND NOTIFICATION"
        android:textColor="@color/primary"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TITLE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etNotificationTitle"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_fancy_input"
        android:hint="Notification title"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:paddingHorizontal="16dp"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MESSAGE"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:letterSpacing="0.15"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etNotificationMessage"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_fancy_input"
        android:hint="Type your message..."
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:textSize="14sp"
        android:gravity="top"
        android:layout_marginBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSendNotification"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="📤 SEND TO ALL PLAYERS"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:background="@drawable/bg_fancy_button_primary"
        android:backgroundTint="@android:color/transparent"
        android:layout_marginBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuickAlert"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="⚡ QUICK ALERTS"
        android:textColor="@color/gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="@drawable/bg_fancy_card"
        android:backgroundTint="@android:color/transparent" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>
