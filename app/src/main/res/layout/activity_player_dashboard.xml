<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090d16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Player Dashboard"
            android:textColor="#38bdf8"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Player Stats Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#131c31"
            app:cardCornerRadius="12dp"
            app:strokeColor="#1e293b">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Player"
                    android:textColor="#ffffff"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvPlayerScore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Score: 0"
                        android:textColor="#38bdf8"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPlayerLevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Level 1"
                        android:textColor="#10b981"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvKills"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kills: 0"
                        android:textColor="#e2e8f0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvWins"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Wins: 0"
                        android:textColor="#e2e8f0"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvMatches"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Matches: 0"
                        android:textColor="#e2e8f0"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvWinRate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Win Rate: 0%"
                    android:textColor="#f59e0b"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvCoins"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Coins: 0"
                        android:textColor="#f59e0b"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRank"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rank: Iron"
                        android:textColor="#94a3b8"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Submit Match Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitMatch"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:text="📝 SUBMIT MATCH"
            android:textColor="#090d16"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#10b981"
            app:cornerRadius="12dp" />

        <!-- Feature Buttons -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Features"
            android:textColor="#ffffff"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLeaderboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🏆 Board"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="💬 Chat"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVoice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🎙️ Voice"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="👤 Profile"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSchedule"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="📅 Schedule"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFriends"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="🤝 Friends"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAchievements"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="🏅 Awards"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSeason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="🗓️ Season"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAnnouncementsPlayer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="📢 News"
                android:textAllCaps="false"
                android:textSize="11sp"
                app:backgroundTint="#1e293b" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:text="🚪 Logout"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:backgroundTint="#7f1d1d"
            app:cornerRadius="10dp" />

    </LinearLayout>
</ScrollView>
