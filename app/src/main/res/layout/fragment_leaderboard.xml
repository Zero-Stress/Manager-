<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#090d16"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Gaming Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_gaming_gradient">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LEADERBOARD"
                android:textColor="#ffffff"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.2" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daily &amp; Weekly Rankings"
                android:textColor="#e0f2fe"
                android:textSize="12sp"
                android:letterSpacing="0.1"
                android:paddingTop="4dp" />
        </LinearLayout>

        <!-- Daily Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DAILY RANKINGS"
            android:textColor="#38bdf8"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:padding="12dp" />

        <TextView
            android:id="@+id/daily_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No daily data yet"
            android:textColor="#64748b"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="visible" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:scrollbars="none">

            <TableLayout
                android:id="@+id/daily_leaderboard_table"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </HorizontalScrollView>

        <!-- Weekly Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WEEKLY RANKINGS"
            android:textColor="#a855f7"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:padding="12dp" />

        <TextView
            android:id="@+id/weekly_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No weekly data yet"
            android:textColor="#64748b"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="visible" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <TableLayout
                android:id="@+id/weekly_leaderboard_table"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
