<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#f59e0b"
                android:endColor="#d97706"
                android:angle="135" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#292524"
                android:endColor="#1c1917"
                android:angle="135" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
