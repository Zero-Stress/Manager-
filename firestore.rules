rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Daily logs
    match /dailylogs/{logId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Announcements
    match /announcements/{announcementId} {
      allow read: if true;
      allow write: if true;
    }
    
    // App state (weekly data persistence, version config)
    match /appState/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
