rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null || true;

      // Achievements subcollection
      match /achievements/{achievementId} {
        allow read, write: if request.auth != null || true;
      }
    }

    // Daily logs
    match /dailylogs/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Announcements
    match /announcements/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // App state
    match /appState/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // App settings (theme customizer)
    match /appSettings/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Squads
    match /squads/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Tournaments
    match /tournaments/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Chat messages
    match /chat/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Match schedules
    match /schedules/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Seasons
    match /seasons/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Attendance
    match /attendance/{docId} {
      allow read, write: if request.auth != null || true;
    }

    // Voice channels (for real-time voice chat)
    match /voiceChannels/{channelId} {
      allow read, write: if request.auth != null || true;

      // Participants subcollection
      match /participants/{participantId} {
        allow read, write: if request.auth != null || true;
      }
    }
  }
}
